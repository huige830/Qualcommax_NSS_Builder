# PPE 流卸载固件 — 仅 JDCloud RE-CS-02（雅典娜）单设备构建。
# prepare-build.sh 把本文件拼在 devices/common-ppe/config 之后运行 defconfig。
#
# 注意：
# - 必须先选子目标 ipq60xx 再选设备符号，否则依赖不满足会被 defconfig 丢弃；
# - 中文界面只需 CONFIG_LUCI_LANG_zh_Hans=y，各应用的 i18n 包
#   （luci-i18n-*-zh-cn，注意包名用 zh-cn 别名）会由 luci.mk 的 DEFAULT 自动选中。

CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

## LuCI 简体中文（自动带上 base/firewall/sqm/ttyd/package-manager 等翻译）
CONFIG_LUCI_LANG_zh_Hans=y

## 系统管理类（管理权/启动项/计划任务/LED/挂载点/备份升级随 luci-mod-system 自带）
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

## SFTP 服务端（上游默认不带，SSH 工具的文件管理依赖它；ImmortalWrt 默认内置）
CONFIG_PACKAGE_openssh-sftp-server=y

## ucode math 模块（fluent 等第三方主题的 header.ut 需要 srand，主题包未声明此依赖）
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_block-mount=y

## UPnP 自动端口转发（官方 luci feed，自动带 miniupnpd）
CONFIG_PACKAGE_luci-app-upnp=y

## 第三方应用（workflow 克隆进 package/）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-advanced=y
CONFIG_PACKAGE_luci-app-diskman=y

## 分区扩容（sirpdboy，依赖 fdisk/resize2fs/kmod-loop 等已核对存在）
CONFIG_PACKAGE_luci-app-partexp=y

## 温度监控（官方 feeds：统计页图形显示温度。上游 LuCI 概览页本身不显示温度，
## 非插件可改；数据由内核自带的 QCOM_TSENS 提供）
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-thermal=y

## OpenList 事后自行安装（编译太慢）：ssh 下载 apk 包后
##   curl -L -o /tmp/openlist.apk <release url>
##   apk add --allow-untrusted /tmp/openlist.apk
## 本机挂载网盘需 kmod-fuse（内核 6.18 滚动版，kmod 必须随固件编译，无法事后装）
CONFIG_PACKAGE_kmod-fuse=y

## EasyTier 组网（release 预编译核心，kmod-tun 随依赖自动选上）
CONFIG_PACKAGE_luci-app-easytier=y

## Bandix Plus 流量监控（eBPF 后端预编译；注意与硬件流分载的统计口径冲突）
CONFIG_PACKAGE_luci-app-bandix-plus=y

## 雅典娜 LED 点阵屏（预编译守护进程 athena-led + LuCI 界面）
CONFIG_PACKAGE_luci-app-athena-led=y
