# PPE 流卸载固件 — 仅 JDCloud RE-CS-02（雅典娜）单设备构建。
# prepare-build.sh 把本文件拼在 devices/common-ppe/config 之后，
# 后写的覆盖先写的：这里关掉 common-ppe 的全设备 MULTI_PROFILE。

# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

## LuCI 简体中文（此 snapshot 的语言代码是 zh_Hans）
CONFIG_PACKAGE_luci-i18n-base-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-sqm-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh_Hans=y

## 系统管理类
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y
